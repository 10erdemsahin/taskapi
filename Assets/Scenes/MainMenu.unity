  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Hik\xE2ye</b>\nOrman\u0131n derinliklerindeki Yank\u0131 Tap\u0131na\u011F\u0131 y\xFCzy\u0131llard\u0131r kapal\u0131. Kap\u0131ya ula\u015Fmak i\xE7in \xF6nce u\xE7urumu a\u015Fmal\u0131, sonra kap\u0131n\u0131n bek\xE7isi Muhaf\u0131z Kaan'\u0131 ikna etmelisin. Yan\u0131nda yard\u0131mc\u0131 robotun Robo var: senin ula\u015Famad\u0131\u011F\u0131n yerlere o ula\u015Fabilir.\n\n<b>Kontroller</b>\n<mspace=0.6em>WASD </mspace>  Y\xFCr\xFC\n<mspace=0.6em>Shift</mspace>  Ko\u015F\n<mspace=0.6em>Space</mspace>  Z\u0131pla\n<mspace=0.6em>Fare </mspace>  Etrafa bak\n<mspace=0.6em>F    </mspace>  Robo'dan yard\u0131m iste\n<mspace=0.6em>E    </mspace>  Etkile\u015Fim / konu\u015F\n<mspace=0.6em>Esc  </mspace>  Diyalo\u011Fu kapat / duraklat\n\n<b>\u0130pucu</b>\nRobo etraf\u0131n\u0131 g\xF6rebildi\u011Fi kadar\u0131n\u0131 bilir. Muhaf\u0131z ise kaba s\xF6zlere de\u011Fil, akla ve kan\u0131ta ikna olur."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
